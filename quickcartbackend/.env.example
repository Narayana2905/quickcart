# --- PostgreSQL ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_postgres
USER_DB_PASSWORD=change_me_user
CATALOG_DB_PASSWORD=change_me_catalog
ORDER_DB_PASSWORD=change_me_order

# --- Security ---
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_EXPIRY_SECONDS=3600
INTERNAL_API_KEY=change_me_internal_key
ADMIN_EMAIL=admin@quickcart.local
ADMIN_PASSWORD=Admin12345

# --- Gateway / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- JVM ---
JAVA_OPTS=-Xms64m -Xmx192m